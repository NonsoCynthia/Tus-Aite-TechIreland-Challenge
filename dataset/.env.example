# Local development only. Copy to .env and change if you like.
# If you change POSTGRES_USER or POSTGRES_DB, also update db/pgadmin/servers.json,
# which has both written in. pgAdmin cannot read environment variables, so the
# pre-provisioned connection is a static file. tests/test_schema.py asserts the two
# agree, so a mismatch fails a test rather than surfacing as a confusing login error.
POSTGRES_USER=triage_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=triage
POSTGRES_PORT=5433

# pgAdmin web console
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_locally
PGADMIN_PORT=5050

# Hugging Face dataset to pull from. Must match versions.yml.
HF_DATASET_REPO=Thabang/irish-referral-prioritisation

# Supplied at runtime by the operator. Never commit a real value.
# Your OWN read token, never a shared one. See docs/HUGGINGFACE_ACCESS.md.
HF_TOKEN=
