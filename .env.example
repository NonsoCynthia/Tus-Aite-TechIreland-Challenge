# Local development only. Copy to .env and change if you like.
#
# Consolidated here because docker-compose.yml (db, pgadmin, loader, oxigraph,
# retrieval -- everything) lives at the repo root. Variable substitution in a
# compose file (${POSTGRES_PORT} etc.) only reads .env from the SAME directory
# as the compose file being run, so this file, not dataset/.env.example, is
# what `docker compose` at root actually uses.
#
# If you change POSTGRES_USER or POSTGRES_DB, also update
# dataset/db/pgadmin/servers.json, which has both written in. pgAdmin cannot
# read environment variables, so the pre-provisioned connection is a static
# file. dataset/tests/test_schema.py asserts the two agree.
POSTGRES_USER=triage_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=triage
POSTGRES_PORT=5433

# pgAdmin web console
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_locally
PGADMIN_PORT=5050

# Hugging Face dataset to pull from. Must match dataset/versions.yml.
HF_DATASET_REPO=Thabang/irish-referral-prioritisation

# Supplied at runtime by the operator. Never commit a real value.
# Your OWN read token, never a shared one. See dataset/docs/HUGGINGFACE_ACCESS.md.
HF_TOKEN=

# Host port the retrieval service is published on (retrieval/README.md).
RETRIEVAL_PORT=8000

# Host port the rationale API is published on when `rationale-api` is started.
RATIONALE_PORT=8010

# Comma-separated shared bearer token(s) the retrieval service checks on
# every endpoint except /health (tech-stack.md Decision 6). Anyone holding
# one of these values authenticates as any caller -- no per-caller identity.
# Never commit a real value.
RETRIEVAL_BEARER_TOKENS=change_me_locally

# retrieval_rw is a login role granted membership in agent_rw (see
# dataset/db/migrations/009_retrieval_login_role.sql). Its password is set
# separately, the same way kg_loader's is: after that migration runs,
#   docker compose exec db psql -U triage_admin -d triage \
#     -c "ALTER ROLE retrieval_rw PASSWORD '<this value>';"
# `db` is the internal Docker hostname -- retrieval and db are both defined
# in this same docker-compose.yml and share its default network.
RETRIEVAL_DB_URL=postgresql://retrieval_rw:change_me_locally@db:5432/triage

# Only needed for `rationale`'s `--engine llm` / `?engine=llm` -- the
# deterministic engine (the default) needs neither of these. Never commit a
# real value. See rationale/README.md and decisions.md ADR-010.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
