# Local development only. Copy to .env and change if you like.
#
# Consolidated here because docker-compose.yml (db, pgadmin, loader, oxigraph,
# retrieval -- everything) lives at the repo root. Variable substitution in a
# compose file (${POSTGRES_PORT} etc.) only reads .env from the SAME directory
# as the compose file being run, so this file, not dataset/.env.example, is
# what `docker compose` at root actually uses.
#
# If you change POSTGRES_USER or POSTGRES_DB, also update
# dataset/db/pgadmin/servers.json, which has both written in. pgAdmin cannot
# read environment variables, so the pre-provisioned connection is a static
# file. dataset/tests/test_schema.py asserts the two agree.
POSTGRES_USER=triage_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=triage
POSTGRES_PORT=5433

# pgAdmin web console
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_locally
PGADMIN_PORT=5050

# Hugging Face dataset to pull from. Must match dataset/versions.yml.
HF_DATASET_REPO=Thabang/irish-referral-prioritisation

# Supplied at runtime by the operator. Never commit a real value.
# Your OWN read token, never a shared one. See dataset/docs/HUGGINGFACE_ACCESS.md.
HF_TOKEN=

# Host port the retrieval service is published on (retrieval/README.md).
RETRIEVAL_PORT=8000
