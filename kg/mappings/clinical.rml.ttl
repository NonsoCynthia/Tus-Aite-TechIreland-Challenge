    rr:predicate sosa:hasFeatureOfInterest ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/patient/{hospital_hipe}/{patient_id}" ] ] .
<#SbpMemberMap> a rr:TriplesMap ;
