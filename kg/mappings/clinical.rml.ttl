@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix eat:  <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/ns#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ================= Conditions =================

<#ConditionMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.conditions" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/condition/{hospital_hipe}/{pathway_number}/{icd10am_code}" ;
    rr:class eat:Condition ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [ rr:predicate eat:conditionLabel ; rr:objectMap [ rr:column "condition_label" ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:isPrimary ;
    rr:objectMap [ rr:column "is_primary" ; rr:datatype xsd:boolean ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:icd10amCode ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/icd10am/{icd10am_code}" ] ] .

# snomed_ct_id is nullable -- own IS NOT NULL map. SNOMED IRIs are referenced under
# http://snomed.info/id/, never minted under eatd: (namespaces.md §4).
<#ConditionSnomedMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.conditions WHERE snomed_ct_id IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/condition/{hospital_hipe}/{pathway_number}/{icd10am_code}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:snomedCode ;
    rr:objectMap [ rr:template "http://snomed.info/id/{snomed_ct_id}" ] ] .

<#ReferralHasConditionMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.conditions" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/referral/{hospital_hipe}/{pathway_number}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:hasCondition ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/condition/{hospital_hipe}/{pathway_number}/{icd10am_code}" ] ] .

# ================= Observations =================
# core.observations has no patient_id column -- sosa:hasFeatureOfInterest needs the
# patient, not the referral, so every observation-bearing query joins to core.referrals.

<#ObservationEventMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.observations" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/obs-event/{hospital_hipe}/{pathway_number}/{obs_datetime}" ;
    rr:class eat:ObservationEvent ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] .

<#ReferralHasObservationEventMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.observations" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/referral/{hospital_hipe}/{pathway_number}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:hasObservationEvent ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/obs-event/{hospital_hipe}/{pathway_number}/{obs_datetime}" ] ] .

# One pair of triples maps per measured column: one asserts the sosa:Observation's own
# properties (observedProperty/hasSimpleResult/resultTime/hasFeatureOfInterest), the other
# links the parent ObservationEvent to it via sosa:hasMember. Both share one rr:LogicalTable
# per column so the filtered SQL is written once. Every column is nullable (requirements.md
# §4), so each pair is its own IS NOT NULL map -- a null column produces neither triples map
# a row, so no dangling sosa:hasMember and no "None" literal.

<#HrTable> a rr:LogicalTable ;
  rr:sqlQuery "SELECT o.hospital_hipe, o.pathway_number, o.obs_datetime, o.hr, r.patient_id FROM core.observations o JOIN core.referrals r ON o.hospital_hipe = r.hospital_hipe AND o.pathway_number = r.pathway_number WHERE o.hr IS NOT NULL" .
<#HrObservationMap> a rr:TriplesMap ;
  rr:logicalTable <#HrTable> ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/obs/{hospital_hipe}/{pathway_number}/{obs_datetime}/hr" ;
    rr:class sosa:Observation ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:observedProperty ; rr:objectMap [ rr:constant eat:heartRate ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:hasSimpleResult ; rr:objectMap [ rr:column "hr" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:resultTime ; rr:objectMap [ rr:column "obs_datetime" ; rr:datatype xsd:dateTime ] ] ;
  rr:predicateObjectMap [
    rr:predicate sosa:hasFeatureOfInterest ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/patient/{hospital_hipe}/{patient_id}" ] ] .
<#HrMemberMap> a rr:TriplesMap ;
  rr:logicalTable <#HrTable> ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/obs-event/{hospital_hipe}/{pathway_number}/{obs_datetime}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate sosa:hasMember ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/obs/{hospital_hipe}/{pathway_number}/{obs_datetime}/hr" ] ] .

<#SbpTable> a rr:LogicalTable ;
  rr:sqlQuery "SELECT o.hospital_hipe, o.pathway_number, o.obs_datetime, o.sbp, r.patient_id FROM core.observations o JOIN core.referrals r ON o.hospital_hipe = r.hospital_hipe AND o.pathway_number = r.pathway_number WHERE o.sbp IS NOT NULL" .
