@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix eat:  <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<#SpecialtyMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_specialty" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/specialty/{specialty_hipe}" ;
    rr:class eat:Specialty ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:column "specialty_name" ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:isPaediatric ;
    rr:objectMap [ rr:column "is_paediatric" ; rr:datatype xsd:boolean ] ] .

<#CPCConceptMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_codes WHERE code_table = 'triage_category'" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/cpc/{code_value}" ;
    rr:class eat:CPC ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:inScheme ;
    rr:objectMap [ rr:constant eat:CPCScheme ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "code_value" ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:column "description" ] ] .

# severity_rank and crt_days are each null for at least one triage_category row (code 4
# "Excluded" has both null; code 2 "Routine" has null crt_days). Morph-KGC materialises a
# NULL as the literal string "None" if mapped directly (requirements.md §4) -- each gets its
# own IS NOT NULL triples map, as referral_state.rml.ttl does for valid_to.
<#CPCSeverityRankMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_codes WHERE code_table = 'triage_category' AND severity_rank IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/cpc/{code_value}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:severityRank ;
    rr:objectMap [ rr:column "severity_rank" ; rr:datatype xsd:positiveInteger ] ] .

<#CPCCrtDaysMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_codes WHERE code_table = 'triage_category' AND crt_days IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/cpc/{code_value}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:crtDays ;
    rr:objectMap [ rr:column "crt_days" ; rr:datatype xsd:integer ] ] .

# code 4 "Excluded" is minted by CPCConceptMap above (a scheme member, skos:notation "4",
# skos:prefLabel "Excluded") but deliberately gets no eat:severityRank (filtered out by
# CPCSeverityRankMap's IS NOT NULL clause) and no eat:crtDays. It also gets no eat:outranks
# triple in either direction anywhere in the graph -- those three triples are static content
# in eat.ttl/ontology.md §6, not generated by this mapping, and cover only codes 1/2/3.
# Giving code 4 a rank would let RULE-ORDER compare an excluded referral against a real
# category, which is not a comparison that means anything.

<#TriageOutcomeConceptMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_codes WHERE code_table = 'triage_outcome'" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage_outcome/{code_value}" ;
    rr:class eat:TriageOutcome ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:inScheme ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/scheme/{code_table}" ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "code_value" ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:column "description" ] ] .

# The remaining six code_tables (gp_priority, referral_source, removal_reason,
# suspension_reason, cancellation_reason, clinic_classification) have no dedicated eat:
# class -- ontology.md only names eat:CPC (triage_category) and eat:TriageOutcome
# (triage_outcome). Every other code becomes a plain skos:Concept, per R6.
<#OtherRefCodesConceptMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_codes WHERE code_table NOT IN ('triage_category', 'triage_outcome')" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/{code_table}/{code_value}" ;
    rr:class skos:Concept ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:inScheme ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/scheme/{code_table}" ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:notation ;
    rr:objectMap [ rr:column "code_value" ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:column "description" ] ] .

# One skos:ConceptScheme per code_table, except triage_category: eat:CPCScheme is already
# declared as static TBox content in eat.ttl (ontology.md §6), not minted by a mapping.
<#RefCodesSchemeMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT DISTINCT code_table FROM core.ref_codes WHERE code_table <> 'triage_category'" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/scheme/{code_table}" ;
    rr:class skos:ConceptScheme ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate skos:prefLabel ;
    rr:objectMap [ rr:column "code_table" ] ] .

<#RuleMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_rules" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/rule/{rule_id}" ;
    rr:class eat:Rule ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:statement ;
    rr:objectMap [ rr:column "statement" ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:appliesTo ;
    rr:objectMap [ rr:column "applies_to" ] ] .

# threshold_days is null for RULE-ORDER and RULE-TIEBREAK -- its own IS NOT NULL map, same
# reasoning as the CPC maps above.
<#RuleThresholdDaysMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.ref_rules WHERE threshold_days IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/rule/{rule_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/reference> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:thresholdDays ;
    rr:objectMap [ rr:column "threshold_days" ; rr:datatype xsd:nonNegativeInteger ] ] .
