    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage-event/{triage_event_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:triageDate ;
    rr:objectMap [ rr:column "triage_date" ; rr:datatype xsd:date ] ] .

<#TriageEventDateReturnedMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.triage_events WHERE date_returned_from_triage IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage-event/{triage_event_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:dateReturnedFromTriage ;
    rr:objectMap [ rr:column "date_returned_from_triage" ; rr:datatype xsd:date ] ] .

<#TriageEventOutcomeMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.triage_events WHERE triage_outcome IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage-event/{triage_event_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:hasTriageOutcome ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage_outcome/{triage_outcome}" ] ] .

<#TriageEventCategoryMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.triage_events WHERE triage_category IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage-event/{triage_event_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:assignedCategory ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/cpc/{triage_category}" ] ] .

<#TriageEventTurnaroundMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.triage_events WHERE turnaround_days IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/triage-event/{triage_event_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
