# ================= eat:Patient / eat:Person (core.patients, core.persons) =================
# eat:isRecordOf is only asserted where ihi_number is present -- no Person node, no
# placeholder, no blank node where it is null (decisions.md §4).

<#PatientMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.patients" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/patient/{hospital_hipe}/{patient_id}" ;
    rr:class eat:Patient ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:atHospital ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/hospital/{hospital_hipe}" ] ] ;
  rr:predicateObjectMap [ rr:predicate eat:sex ; rr:objectMap [ rr:column "patient_sex" ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:dateOfBirth ;
    rr:objectMap [ rr:column "patient_date_of_birth" ; rr:datatype xsd:date ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:areaOfResidenceCode ;
    rr:objectMap [ rr:column "area_of_residence_code" ] ] .

<#PatientIsRecordOfMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.patients WHERE ihi_number IS NOT NULL" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/patient/{hospital_hipe}/{patient_id}" ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:isRecordOf ;
    rr:objectMap [ rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/person/{ihi_number}" ] ] .

<#PersonMap> a rr:TriplesMap ;
  rr:logicalTable [ rr:sqlQuery "SELECT * FROM core.persons" ] ;
  rr:subjectMap [
    rr:template "https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/id/person/{ihi_number}" ;
    rr:class eat:Person ;
    rr:graphMap [ rr:constant <https://nonsocynthia.github.io/Tus-Aite-TechIreland-Challenge/kg/graph/inputs> ] ] ;
  rr:predicateObjectMap [ rr:predicate eat:sex ; rr:objectMap [ rr:column "person_sex" ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:dateOfBirth ;
    rr:objectMap [ rr:column "person_date_of_birth" ; rr:datatype xsd:date ] ] ;
  rr:predicateObjectMap [
    rr:predicate eat:areaOfResidenceCode ;
    rr:objectMap [ rr:column "area_of_residence_code" ] ] .
