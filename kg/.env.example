# Copy to kg/.env and fill in. kg/.env is git-ignored.
# Read-only loader role. Has no access to schema eval by design:
# a mapping that touches ground_truth fails with a permission error.
KG_LOADER_PASSWORD=change_me_locally

# Connection string used by Morph-KGC. Host port, per dataset/docs section 3.
KG_DB_URL=postgresql+psycopg://kg_loader:change_me_locally@localhost:5433/triage

# Where materialised triples are written before loading into Oxigraph.
KG_OUTPUT_DIR=kg/out
