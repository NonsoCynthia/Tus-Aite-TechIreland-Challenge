# Copy to retrieval/.env and fill in. retrieval/.env is git-ignored.

# Comma-separated shared bearer token(s), FR7 in the track's spec.md. Anyone
# holding one of these values authenticates as any caller -- there is no
# per-caller identity at this layer (see NFR4: single shared static token,
# not production-grade auth). Never commit a real value.
RETRIEVAL_BEARER_TOKENS=change_me_locally

# retrieval_rw is a login role granted membership in agent_rw (see
# dataset/db/migrations/009_retrieval_login_role.sql). Its password is set
# separately, the same way kg_loader's is: after the migration runs,
#   ALTER ROLE retrieval_rw PASSWORD '<this value>';
# `db` is the internal Docker hostname -- this service and the dataset
# stack's db container share the triage_net network (see docker-compose.yml
# and dataset/docker-compose.yml).
RETRIEVAL_DB_URL=postgresql://retrieval_rw:change_me_locally@db:5432/triage

# Host port this service is published on. Only read by `docker compose` (from
# the repo-root .env, not this file) for the port-mapping substitution in
# docker-compose.yml -- listed here as documentation of the default.
RETRIEVAL_PORT=8000
